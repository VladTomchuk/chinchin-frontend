# Публічна адреса сайту. Від неї рахуються canonical, hreflang, Open Graph,
# sitemap.xml і robots.txt. Без значення береться https://chinchinevents.com.
NEXT_PUBLIC_SITE_URL=

# API (те, що доступно на клієнті, бо має NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=

# Секрети (доступні тільки на сервері)
DATABASE_URL=
SECRET_KEY=
# Google Places API — блок відгуків. Ключ береться з Google Cloud Console,
# без префікса NEXT_PUBLIC_: він мусить лишатись на сервері.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=ChIJoeVBCD3PKI4RY3cq-eatM6Y

# SMTP поштової скриньки Titan Email — форма контактів (app/api/contact/route.ts,
# lib/mailer.ts). Пароль береться в налаштуваннях самої скриньки (той самий
# логін/пароль, що для входу у вебпошту). Без TITAN_SMTP_PASSWORD форма просто
# не надсилає лист і повертає зрозумілу помилку — сторінка не падає.
# TITAN_SMTP_USER не обов'язковий: за замовчуванням береться CONTACT_EMAIL
# (config/site.ts) — окрему технічну скриньку заводити не треба.
TITAN_SMTP_USER=
TITAN_SMTP_PASSWORD=
